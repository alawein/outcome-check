{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alawein/outcome-check/schemas/v1/report.schema.json",
  "title": "Outcome Check v1 report",
  "$defs": {
    "json": {
      "oneOf": [
        {
          "type": [
            "null",
            "boolean",
            "number",
            "string"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        },
        "expected": {
          "$ref": "#/$defs/json"
        },
        "observation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "subject",
        "path",
        "expected",
        "observation_id",
        "max_age_seconds",
        "action_id"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "observed_at": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "state": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      },
      "required": [
        "id",
        "subject",
        "observed_at",
        "state"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "unknown"
          ]
        }
      },
      "required": [
        "id",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "action": {
            "enum": [
              "confirmed",
              "contradicted",
              "unobserved",
              "not_required"
            ]
          },
          "outcome": {
            "enum": [
              "confirmed",
              "contradicted",
              "unobserved"
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "contradicted",
              "unobserved"
            ]
          },
          "reason": {
            "type": "string"
          },
          "action_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "observation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "action",
          "outcome",
          "status",
          "reason",
          "action_id",
          "observation_id"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "contradicted": {
          "type": "integer",
          "minimum": 0
        },
        "unobserved": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "confirmed",
        "contradicted",
        "unobserved"
      ],
      "additionalProperties": false
    },
    "exit_code": {
      "enum": [
        0,
        1
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "results",
    "counts",
    "exit_code"
  ],
  "additionalProperties": false
}
